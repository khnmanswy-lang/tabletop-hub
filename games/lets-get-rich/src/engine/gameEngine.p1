}

export interface EquippedMainSkillEntry {
  skillId: MainSkillId;
  def: SkillDefinition;
  procPct: number;
  sourceType: 'CHARACTER' | 'TREASURE';
  sourceName: string;
  sourceEmoji: string;
  usesRemaining: number | null;
  maxUses: number | null;
}

export interface EquippedSubSkillEntry {
  skillId: SubSkillId;
  def: SkillDefinition;
  totalProcPct: number;
  sources: {
    sourceType: 'CHARACTER' | 'TREASURE';
    sourceName: string;
    sourceEmoji: string;
    procPct: number;
  }[];
  usesRemaining: number | null;
  maxUses: number | null;
}

export interface ComputedPlayerStats {
  dcLevel: number;
  dcProcPct: number;
  gaugeSpeed: number;
  constDcLevel: number;
  constDiscountPct: number;
  acqDcLevel: number;
  acqDiscountPct: number;
  tollDcLevel: number;
  tollDiscountPct: number;
  salLuckLevel: number;
  salBonusPct: number;
  doubleBoostPct: number;
}

