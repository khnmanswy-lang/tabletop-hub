P4 on Right (NO fake Gold/Diamond/Clover) -->
      <div style="display:flex; justify-content:space-between; align-items:center; height:44px; margin-bottom:8px;">
        <div style="display:flex; align-items:center; gap:8px;">
          <button class="red-btn" id="loadoutBtnBackLobby" style="padding:5px 12px; font-size:13px;">⬅ LOBBY</button>
          <button class="royal-panel" id="loadoutBtnHome" style="padding:5px 11px; font-size:13px; cursor:pointer;">🏠 MENU</button>
          <span style="font-size:18px; font-weight:900; letter-spacing:0.5px; text-shadow:0 2px 4px #000; margin-left:4px;">
            CHARACTER & TREASURE LOADOUT
          </span>
        </div>
        <div style="display:flex; gap:6px; align-items:center;">
          <span style="font-size:12px; font-weight:900; color:#fde047; margin-right:4px;">เลือกผู้เล่น:</span>
          ${playerSwitcherHtml}
        </div>
      </div>

      <!-- 3-Column Body -->
      <div style="display:grid; grid-template-columns: 28% 37% 33%; gap:12px; height:calc(100% - 52px);">
        <!-- Left Column: Pedestal + 3 Treasure Slots -->
        <div style="display:flex; flex-direction:column; gap:8px; height:100%;">
          <div class="royal-panel" style="flex:1.25; display:flex; flex-direction:column; align-items:center; justify-content:space-between; padding-bottom:12px;">
            <div class="royal-header" style="width:100%;">
              <span>${targetPlayer.name} (${targetPlayer.id})</span>
              <span style="color:#fde047;">RANK ${curChar.rank}</span>
            </div>
            <!-- S+ Character Card on Glowing Pedestal -->
            <div style="width:162px; background:linear-gradient(180deg, ${curChar.accentColor} 0%, #1e1b4b 100%); border:3px solid #fde047; border-radius:14px; padding:10px; text-align:center; box-shadow:0 0 24px ${curChar.accentColor}99; position:relative;">
              <span style="position:absolute; top:-8px; left:-8px; background:#0f172a; border:2px solid #fde047; border-radius:8px; padding:1px 6px; font-size:15px; font-weight:900; color:#fde047;">${curChar.rank}</span>
              <div style="font-size:52px; line-height:1.1;">${curChar.avatarEmoji}</div>
              <div style="font-size:16px; font-weight:900; color:#fef08a; margin-top:4px;">${curChar.name}</div>
              <div style="font-size:11px; color:#e2e8f0; font-weight:700;">${curChar.title}</div>
            </div>
            <!-- Glowing Pedestal Base -->
            <div style="width:190px; height:22px; border-radius:50%; background:radial-gradient(circle, #38bdf8 0%, #4f46e5 70%, transparent 100%); border:2px solid #a5f3fc; box-shadow:0 0 16px #38bdf8;"></div>
          </div>

          <div class="royal-panel" style="flex:0.85; display:flex; flex-direction:column;">
            <div class="royal-header">
              <span>TREASURE (ห้ามซ้ำ Main ตลค)</span>
              <span style="color:#fde047;">3 ชิ้น</span>
            </div>
            <div style="display:grid; grid-template-columns:repeat(3,1fr); gap:8px; padding:8px; flex:1; align-items:stretch;">
              ${equippedSlotsHtml}
            </div>
          </div>
        </div>

        <!-- Middle Column: 5 Segmented Stat Bars + Active Skill Box -->
        <div class="royal-panel" style="display:flex; flex-direction:column; overflow:hidden;">
          <div class="royal-header">
            <span>CHARACTER STATS & SKILLS</span>
            <span style="color:#fde047;">+0 .. +5</span>
          </div>
          <div style="padding:10px 14px; display:flex; flex-direction:column; gap:8px; flex:1; justify-content:space-between; overflow-y:auto;" class="lgr-scroll">
            <div style="display:flex; flex-direction:column; gap:7px;">
              ${statBarsHtml}
            </div>

            <!-- SKILL Box -->
            <div style="background:#112240; border:2px solid #3b82f6; border-radius:10px; padding:8px 10px; display:flex; flex-direction:column; gap:5px;">
              <div style="text-align:center; font-size:11px; font-weight:900; color:#93c5fd; border-bottom:1px solid #1e3a8a; padding-bottom:3px;">
                SKILL ประจำตัวละคร & เรทรวมสุทธิ ((÷3)×1.6 | Sub บวกทับตรงๆ)
              </div>
              <div style="background:#1e1b4b; border:1px solid #a855f7; border-radius:6px; padding:4px 8px; font-size:11px;">
                <strong style="color:#fde047;">Main (${charMainDef.code}):</strong> ${charMainDef.name} (${curChar.mainSkill.procPct}%) — <span style="color:#cbd5e1;">${charMainDef.effectDesc}</span>
              </div>
              <div style="background:#0f172a; border:1px solid #3b82f6; border-radius:6px; padding:4px 8px; font-size:11px;">
                <strong style="color:#7dd3fc;">Char Sub 1 (${charSub1Def.code}):</strong> ${charSub1Def.name} (${curChar.subSkills[0].procPct}%)
              </div>
              <div style="background:#0f172a; border:1px solid #3b82f6; border-radius:6px; padding:4px 8px; font-size:11px;">
                <strong style="color:#7dd3fc;">Char Sub 2 (${charSub2Def.code}):</strong> ${charSub2Def.name} (${curChar.subSkills[1].procPct}%)
              </div>
              <div style="font-size:11px; font-weight:900; color:#fde047; margin-top:2px;">
                ⚡ Active Stacked Sub Skills (ตัวละคร + สมบัติ 3 ชิ้น):
              </div>
              <div style="display:flex; flex-direction:column; gap:3px;">
                ${stackedSubsHtml}
              </div>
            </div>
          </div>
        </div>

        <!-- Right Column: INVENTORY (Characters / Treasures Tabs + Grid + Confirm Button) -->
        <div class="royal-panel" style="display:flex; flex-direction:column; justify-content:space-between; overflow:hidden;">
          <div class="royal-header">
            <span>INVENTORY (${targetPlayer.id})</span>
            <span style="color:#93c5fd;">เลือกจัดเซ็ต</span>
          </div>
          <div style="padding:8px 10px; display:flex; flex-direction:column; gap:8px; flex:1; overflow:hidden;">
            <div style="display:grid; grid-template-columns:1fr 1fr; gap:6px;">
              <button class="${this.loadoutInvTab === 'CHAR' ? 'gold-btn' : 'tab-pill'}" id="invTabChar" style="padding:6px; font-size:12px;">
                CHARACTERS (8)
              </button>
              <button class="${this.loadoutInvTab === 'TR' ? 'gold-btn' : 'tab-pill'}" id="invTabTr" style="padding:6px; font-size:12px;">
                TREASURES (10)
              </button>
            </div>
            <div style="display:grid; grid-template-columns:repeat(3, 1fr); gap:6px; overflow-y:auto; flex:1; padding-right:3px; align-content:start;" class="lgr-scroll">
              ${inventoryGridHtml}
            </div>
          </div>
          <div style="padding:8px 12px;">
            <button class="gold-btn" id="btnConfirmLoadout" style="width:100%; padding:9px; font-size:14px;">
              ✔ CONFIRM LOADOUT (ไปหน้า LOBBY)
            </button>
          </div>
        </div>
      </div>
    `;

    // Wire events
    container
      .querySelector('#loadoutBtnBackLobby')
      ?.addEventListener('click', () => this.showScreen('LOBBY'));
    container
      .querySelector('#loadoutBtnHome')
      ?.addEventListener('click', () => this.showScreen('MAIN_MENU'));
    container
      .querySelector('#btnConfirmLoadout')
      ?.addEventListener('click', () => this.showScreen('LOBBY'));

    container.querySelectorAll('.loadout-p-switch').forEach((btn) => {
      btn.addEventListener('click', () => {
        const pid = (btn as HTMLElement).dataset.pid as PlayerId;
        if (pid) {
          this.selectedLoadoutPlayerId = pid;
          this.renderLoadoutScreen();
        }
      });
    });

    container.querySelector('#invTabChar')?.addEventListener('click', () => {
      this.loadoutInvTab = 'CHAR';
      this.renderLoadoutScreen();
    });
    container.querySelector('#invTabTr')?.addEventListener('click', () => {
      this.loadoutInvTab = 'TR';
      this.renderLoadoutScreen();
    });

    container.querySelectorAll('.inv-char-card').forEach((card) => {
      card.addEventListener('click', () => {
        const charId = (card as HTMLElement).dataset.charId;
        if (!charId) return;
        const newChar = getCharacterDef(charId);
        // Auto-remove any treasure that conflicts with new character's Main skill
        const filtered = targetPlayer.treasureIds.filter(
          (tid) =>
            !isMainSkillConflict(getTreasureDef(tid).mainSkill.skillId, newChar.mainSkill.skillId)
        );
        for (const tr of TREASURE_POOL) {
          if (
            filtered.length < 3 &&
            !isMainSkillConflict(tr.mainSkill.skillId, newChar.mainSkill.skillId) &&
            !filtered.includes(tr.id)
          ) {
            filtered.push(tr.id);
          }
        }
        const nextTr = [filtered[0], filtered[1], filtered[2]] as [
          string,
          string,
          string,
        ];
        targetPlayer.characterId = newChar.id;
        targetPlayer.treasureIds = nextTr;
        this.callbacks.onUpdatePlayerLoadout?.(
          targetPlayer.id,
          newChar.id,
          nextTr
        );
        this.renderLoadoutScreen();
      });
    });

    container.querySelectorAll('.inv-tr-card').forEach((card) => {
      card.addEventListener('click', () => {
        const trId = (card as HTMLElement).dataset.trId;
        if (!trId) return;
        const trDef = getTreasureDef(trId);
        if (isMainSkillConflict(trDef.mainSkill.skillId, curChar.mainSkill.skillId)) {
          return; // Blocked: conflicts with Character Main
        }
        const list = [...targetPlayer.treasureIds];
        if (list.includes(trId)) {
          return; // Already equipped
        }
        list.shift();
        list.push(trId);
        const nextTr = [list[0], list[1], list[2]] as [string, string, string];
        targetPlayer.treasureIds = nextTr;
        this.callbacks.onUpdatePlayerLoadout?.(
          targetPlayer.id,
          targetPlayer.characterId,
          nextTr
        );
        this.renderLoadoutScreen();
      });
    });
  }

  // ==========================================================================
  // ==========================================================================
  // SCREEN 3: UNIFIED LOBBY (Topbar + 4x Player Banners + 1/3 Pick / 2/3 Inspect)
  // ==========================================================================
  private renderLobbyScreen(): void {
    const container = this.stageEl.querySelector(
      '#screen_LOBBY'
    ) as HTMLElement;
    if (!container) return;

    const isTeamMode = this.state.mode === 'TEAM_2V2';
    const ffaCount = this.state.ffaPlayerCount ?? 4;
    const isPlayerSlotActive = (p: PlayerState | undefined, idx: number): boolean => {
      if (!p) return false;
      if (typeof p.isSlotActive === 'boolean') return p.isSlotActive;
      return isTeamMode || idx < ffaCount;
    };
    const activeSlotCount = this.state.players.filter((p, idx) => isPlayerSlotActive(p, idx)).length;

    // Ensure selected player is an active slot
    if (
      !this.state.players.some(
        (p, idx) => p.id === this.selectedLoadoutPlayerId && isPlayerSlotActive(p, idx)
      )
    ) {
      const firstActive = this.state.players.find((p, idx) => isPlayerSlotActive(p, idx));
      this.selectedLoadoutPlayerId = firstActive?.id ?? 'P1';
    }
    const targetPlayer =
      this.state.players.find((p) => p.id === this.selectedLoadoutPlayerId) ??
      this.state.players[0];

    const curChar: CharacterDef = getCharacterDef(targetPlayer.characterId);
    const curTrIds = [...targetPlayer.treasureIds] as [string, string, string];
    const charMainDef = getSkillDef(curChar.mainSkill.skillId);
    const combinedSkills = computeCombinedPlayerSkills(
      curChar.id,
      curTrIds,
      targetPlayer.skillUsesRemaining
    );

    // 1. Topbar Mode Buttons & Controls
    const startBalLabel = formatMarbleCompact(
      MATCH_CONFIG.startingMarbleByPlayer[targetPlayer.id] ?? MATCH_CONFIG.startingMarble
    );

    // 2. Player Banners (4x Horizontal Row - Chunky Toy License Cards)
    const playerBannerGradients: Record<PlayerId, string> = {
      P1: 'linear-gradient(135deg, #EF4444 0%, #B91C1C 100%)',
      P2: 'linear-gradient(135deg, #3B82F6 0%, #1D4ED8 100%)',
      P3: 'linear-gradient(135deg, #10B981 0%, #047857 100%)',
      P4: 'linear-gradient(135deg, #F59E0B 0%, #B45309 100%)',
    };

    const playerBannersHtml = PLAYER_IDS.map((pid, idx) => {
      const p = this.state.players[idx];
      const isActiveSlot = isPlayerSlotActive(p, idx);
      const isSelected = pid === this.selectedLoadoutPlayerId;

      if (!isActiveSlot || !p) {
        return `
          <div class="lobby-banner-empty" style="background:#FFF9EB; border:3px dashed #A89078; border-radius:14px; padding:6px 10px; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:6px; height:88px; box-shadow:inset 0 2px 4px rgba(0,0,0,0.06);">
            <div style="font-size:12px; font-weight:900; color:#786C5E;">ที่นั่ง ${pid} ว่าง (EMPTY SLOT)</div>
            <div style="display:flex; gap:6px; width:100%;">
              <button class="gold-btn btn-lobby-add-ai" data-idx="${idx}" style="flex:1; padding:5px 6px; font-size:11px; font-weight:900; border-radius:8px; cursor:pointer;">
                🤖 + เพิ่ม AI Bot
              </button>
              <button class="tab-pill btn-lobby-add-human" data-idx="${idx}" style="flex:1; padding:5px 4px; font-size:11px; font-weight:900; border-radius:8px; cursor:pointer;">
                👤 + ผู้เล่น
              </button>
            </div>
          </div>
        `;
      }

      const pChar = getCharacterDef(p.characterId);
      const teamBadge = isTeamMode
        ? p.teamId === 'ALPHA' ? 'TEAM A' : 'TEAM B'
        : `SOLO ${p.id}`;

      const isYou = this.youPlayerId ? p.id === this.youPlayerId : false;
      const isHuman = p.controlType === 'HUMAN';
      const isRemoteConnected = isHuman && p.connected && !isYou;

      let controlBadgeHtml = '';
      if (isRemoteConnected) {
        controlBadgeHtml = `<span style="font-size:9.5px; font-weight:900; padding:2px 7px; border-radius:999px; background:#F0FDF4; color:#15803D; border:2px solid #1E1612;">👤 Online</span>`;
      } else {
        controlBadgeHtml = `
          <button class="btn-lobby-toggle-control" data-pid="${p.id}" title="คลิกสลับ: Human (Pass 'n Play) / AI Bot" style="background:${isHuman ? 'linear-gradient(180deg,#22C55E 0%,#16A34A 100%)' : 'linear-gradient(180deg,#38BDF8 0%,#0284C7 100%)'}; border:2px solid #1E1612; color:#fff; border-radius:999px; padding:2px 8px; font-size:9.5px; font-weight:900; cursor:pointer; display:inline-flex; align-items:center; gap:3px; box-shadow:0 2px 0 #1E1612;">
            ${isHuman ? '🟢 Pass \'n Play' : '🤖 AI Bot'}
          </button>
        `;
      }

      const youBadgeHtml = isYou
        ? `<span style="background:#FFD43B; color:#1E1612; font-weight:900; font-size:9px; padding:1px 7px; border-radius:999px; border:2px solid #1E1612; transform:rotate(-3deg); display:inline-block; box-shadow:0 2px 0 #1E1612;">YOU ★</span>`
        : '';

      const kickBtnHtml = !isYou
        ? `<button class="btn-lobby-kick" data-pid="${p.id}" title="Kick Player / Clear Slot" style="background:linear-gradient(180deg,#FF5A5F 0%,#DC2626 100%); border:2px solid #1E1612; color:#fff; border-radius:999px; padding:1px 7px; font-size:9px; font-weight:900; cursor:pointer; display:inline-flex; align-items:center; gap:2px; box-shadow:0 2px 0 #7F1D1D;">✕ Kick</button>`
        : '';

      return `
        <div class="lobby-player-banner" data-pid="${p.id}" style="background:${playerBannerGradients[p.id]}; border:3px solid #1E1612; outline:${isSelected ? '4px solid #FFD43B' : 'none'}; box-shadow:${isSelected ? '0 6px 0 #1E1612, inset 0 2px 0 rgba(255,255,255,0.4)' : '0 4px 0 #1E1612, inset 0 2px 0 rgba(255,255,255,0.3)'}; border-radius:14px; padding:6px 10px; display:flex; flex-direction:column; justify-content:space-between; height:88px; position:relative; cursor:pointer; transition:transform 0.15s ease;">
          <div style="display:flex; justify-content:space-between; align-items:center;">
            <span style="background:#FFF9EB; border:2px solid #1E1612; border-radius:999px; padding:1px 7px; font-size:9.5px; font-weight:900; color:#1E1612; box-shadow:0 1.5px 0 #1E1612;">
              ${teamBadge}
            </span>
            <div style="display:flex; align-items:center; gap:4px;">
              ${youBadgeHtml}
              ${controlBadgeHtml}
              <button class="btn-lobby-randomize" data-pid="${p.id}" title="สุ่มจัดเซ็ตคอมโบ (Synergistic Meta Build)" style="background:linear-gradient(180deg,#A855F7 0%,#7E22CE 100%); border:2px solid #1E1612; color:#fff; border-radius:999px; padding:1px 6px; font-size:9px; font-weight:900; cursor:pointer; display:inline-flex; align-items:center; gap:2px; box-shadow:0 2px 0 #581C87;">🎲 Build</button>
              ${kickBtnHtml}
            </div>
          </div>

          <div style="display:flex; align-items:center; gap:8px;">
            <div style="width:38px; height:38px; border-radius:10px; background:#FFF9EB; border:2px solid #1E1612; display:flex; align-items:center; justify-content:center; flex-shrink:0; box-shadow:0 2px 0 #1E1612; overflow:hidden;">
              ${getMascotSvg(p.characterId, 36)}
            </div>
            <div style="overflow:hidden;">
              <div style="font-size:12px; font-weight:900; color:#fff; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; text-shadow:0 1.5px 0 #1E1612;">
                ${p.name}
              </div>
              <div style="font-size:10px; font-weight:900; color:#FEF08A; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; text-shadow:0 1px 0 rgba(0,0,0,0.5);">
                ${pChar.name} <span style="color:#FFF; font-size:9px;">(${pChar.rank})</span>
              </div>
            </div>
          </div>

          <div style="display:flex; justify-content:space-between; align-items:center; font-size:9px; font-weight:900; color:#FFF;">
            <span>${p.treasureIds.map(tid => getTreasureDef(tid).iconEmoji).join(' ')} <span style="background:rgba(0,0,0,0.25); border-radius:4px; padding:0 3px; font-size:8px; margin-left:2px;">[${CHARACTER_SYNERGIES[p.characterId]?.archetypeTh || ''}]</span></span>
            ${isSelected ? `<span style="background:#FFD43B; color:#1E1612; border:1.5px solid #1E1612; border-radius:999px; padding:0 6px; font-size:8.5px; font-weight:900; transform:rotate(-2deg); display:inline-block;">★ EDITING</span>` : `<span style="opacity:0.85; font-size:8.5px;">Click to Edit</span>`}
          </div>
        </div>
      `;
    }).join('');

    // 3. Left Panel (1/3 Width): Pick Char + Pick Treasure
    const charPickerCardsHtml = CHARACTER_ROSTER.map((c) => {
      const isSelected = c.id === targetPlayer.characterId;
      return `
        <div class="lobby-char-btn" data-char-id="${c.id}" style="background:${isSelected ? 'linear-gradient(180deg,#FFFBEB 0%,#FEF08A 100%)' : '#FFF9EB'}; border:2.5px solid #1E1612; border-radius:10px; padding:4px; text-align:center; cursor:pointer; box-shadow:${isSelected ? 'inset 0 2px 0 rgba(255,255,255,0.8), 0 3px 0 #B45309, 0 5px 0 #1E1612' : '0 3px 0 #1E1612'}; position:relative; transition:transform 0.1s ease;">
          ${isSelected ? `<span style="position:absolute; top:2px; right:3px; font-size:9px; color:#15803D; font-weight:900; background:#DCFCE7; border-radius:50%; width:14px; height:14px; display:flex; align-items:center; justify-content:center; border:1px solid #15803D;">✔</span>` : ''}
          <div style="display:flex; justify-content:center; align-items:center; height:32px;">${getMascotSvg(c.id, 32)}</div>
          <div style="font-size:10px; font-weight:900; color:#1E1612; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; margin-top:2px;">${c.name}</div>
          <div style="font-size:8px; font-weight:900; color:#B45309;">${c.rank} • ${c.mainSkill.procPct}%</div>
        </div>
      `;
    }).join('');

    // Equipped 3 Treasure Slots
    const equippedTrSlotsHtml = curTrIds.map((tid, slotIdx) => {
      const tr = getTreasureDef(tid);
      const isSlotActive = slotIdx === this.selectedTreasureSlotIndex;
      const isConflict = isMainSkillConflict(tr.mainSkill.skillId, curChar.mainSkill.skillId);
      return `
        <div class="lobby-tr-slot-btn" data-slot-idx="${slotIdx}" style="background:${isSlotActive ? '#FEF9C3' : '#FFF9EB'}; border:2.5px solid ${isConflict ? '#DC2626' : '#1E1612'}; border-radius:10px; padding:4px 6px; display:flex; align-items:center; gap:6px; cursor:pointer; box-shadow:${isSlotActive ? '0 3px 0 #CA8A04, 0 5px 0 #1E1612' : '0 3px 0 #1E1612'};">
          <span style="font-size:20px;">${tr.iconEmoji}</span>
          <div style="overflow:hidden; flex:1;">
            <div style="font-size:9px; font-weight:900; color:${isConflict ? '#DC2626' : '#1E1612'}; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
              Slot ${slotIdx + 1}: ${tr.name}
            </div>
            <div style="font-size:8px; color:${isConflict ? '#B91C1C' : '#64748B'}; font-weight:800;">
              ${isConflict ? '⛔ ซ้ำ Main' : `Main ${tr.mainSkill.procPct}%`}
            </div>
          </div>
          ${isSlotActive ? `<span style="font-size:9px; color:#B45309; font-weight:900;">▼</span>` : ''}
        </div>
      `;
    }).join('');

    // 10 Treasure Pool
    const treasurePoolCardsHtml = TREASURE_POOL.map((t) => {
      const isEquippedInActiveSlot = curTrIds[this.selectedTreasureSlotIndex] === t.id;
      const isEquippedAnywhere = curTrIds.includes(t.id);
      const isConflict = isMainSkillConflict(t.mainSkill.skillId, curChar.mainSkill.skillId);
      return `
        <div class="lobby-tr-pool-btn" data-tr-id="${t.id}" title="${t.name} (${t.nameEn})" style="background:${isEquippedInActiveSlot ? '#FEF9C3' : '#FFF9EB'}; border:2px solid ${isConflict ? '#DC2626' : '#1E1612'}; border-radius:8px; padding:3px; text-align:center; cursor:${isConflict ? 'not-allowed' : 'pointer'}; opacity:${isConflict ? 0.45 : 1}; position:relative; box-shadow:0 2px 0 #1E1612;">
          ${isEquippedAnywhere ? `<span style="position:absolute; top:1px; right:2px; font-size:8px; color:#15803D; font-weight:900; background:#DCFCE7; border-radius:50%; width:12px; height:12px; display:flex; align-items:center; justify-content:center; border:1px solid #15803D;">✔</span>` : ''}
          <div style="font-size:20px; line-height:1;">${t.iconEmoji}</div>
          <div style="font-size:9px; font-weight:900; color:#1E1612; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">${t.name}</div>
          <div style="font-size:7.5px; color:${isConflict ? '#B91C1C' : '#64748B'}; font-weight:800;">
            ${isConflict ? 'ซ้ำ Main' : `${t.mainSkill.procPct}%`}
          </div>
        </div>
      `;
    }).join('');

    // 4. Right Panel (2/3 Width): See Abilities + See Sum Stat and Skills
    const statsList = [
      { label: `🎲 Dice Control`, pct: `${STAT_SCALING_TABLE.dcProcPct[curChar.stats.dc]}%`, lv: curChar.stats.dc, color: '#38bdf8' },
      { label: `🛠️ Construction DC`, pct: `-${STAT_SCALING_TABLE.constDiscountPct[curChar.stats.constDc]}%`, lv: curChar.stats.constDc, color: '#fb923c' },
      { label: `🤝 Acquisition DC`, pct: `-${STAT_SCALING_TABLE.acqDiscountPct[curChar.stats.acqDc]}%`, lv: curChar.stats.acqDc, color: '#facc15' },
      { label: `🛡️ Toll Discount`, pct: `-${STAT_SCALING_TABLE.tollDiscountPct[curChar.stats.tollDc]}%`, lv: curChar.stats.tollDc, color: '#f59e0b' },
      { label: `🍀 Salary / Luck`, pct: `+${STAT_SCALING_TABLE.salLuckBonusPct[curChar.stats.salLuck]}%`, lv: curChar.stats.salLuck, color: '#4ade80' },
    ];

    const statBarsHtml = statsList.map((s) => {
      let segs = '';
      for (let i = 1; i <= 5; i++) {
        segs += `<div style="flex:1; height:12px; border-radius:999px; background:${i <= s.lv ? s.color : '#F3E5C8'}; border:2px solid #1E1612; box-shadow:${i <= s.lv ? 'inset 0 2px 0 rgba(255,255,255,0.7), 0 2px 0 #1E1612' : 'none'};"></div>`;
      }
      return `
        <div>
          <div style="display:flex; justify-content:space-between; font-size:11px; font-weight:900; color:#141413; margin-bottom:2px;">
            <span>${s.label} (${s.pct})</span>
            <span style="color:#B45309; font-weight:900;">+${s.lv}/5</span>
          </div>
          <div style="display:flex; gap:3px;">${segs}</div>
 