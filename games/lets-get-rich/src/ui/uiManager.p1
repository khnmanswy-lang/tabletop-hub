export interface ActiveSkillSummary {
  mainSkills: {
    skill: SkillDefinition;
    procPct: number;
    sourceLabel: string;
    usesLeft: number | null;
  }[];
  subSkills: {
    skill: SkillDefinition;
    totalProcPct: number;
    breakdown: string;
    usesLeft: number | null;
  }[];
}

export interface CityConstructionOption {
  level: BuildingLevel;
  label: string;
  subLabel: string;
  icon: string;
  cost: number;
  resultingToll: number;
  locked: boolean;
  lockReason?: string;
}

export interface CityModalPayload {
  playerId: PlayerId;
  tileIndex: number;
  currentLevel: BuildingLevel;
  lapCount: number;
  constDiscountPct: number;
  options: CityConstructionOption[];
  defaultSelectedLevel: BuildingLevel;
}

export interface TakeoverModalPayload {
  buyerId: PlayerId;
  ownerId: PlayerId;
  tileIndex: number;
  buildingLevel: BuildingLevel;
  acqDiscountPct: number;
  rawTakeoverCost: number;
  netTakeoverCost: number;
  resultingToll: number;
  canUpgradeToLandmarkAfter: boolean;
  landmarkUpgradeCost: number;
  paidToll?: number;
  tollExemptReason?: string;
}

export interface AngelCardModalPayload {
  playerId: PlayerId;
  tileIndex: number;
  creditorId: PlayerId | 'BANK';
  tollAmount: number;
  hasDiscountCoupon: boolean;
  discountedTollAmount: number;
