  onScreenChange?: (screen: ScreenState) => void;
  onModeChange?: (mode: GameMode) => void;
  onFfaPlayerCountChange?: (count: 2 | 3 | 4) => void;
  onTogglePlayerControl?: (playerId: PlayerId) => void;
  onUpdatePlayerLoadout?: (
    playerId: PlayerId,
    characterId: string,
    treasureIds: [string, string, string]
  ) => void;
  onStartMatch?: () => void;
  onSetOddEven?: (mode: OddEvenMode) => void;
  onGaugeStepChange?: (fromTileIndex: number | null, activeStep: number | null) => void;
  onGaugeReleaseRoll?: (gaugeValue: number) => void;
  onPayIslandBail?: () => void;
  onConfirmCityBuild?: (targetLevel: BuildingLevel) => void;
  onPassCityBuild?: () => void;
  onConfirmTakeover?: (alsoUpgradeLandmark?: boolean) => void;
  onPassTakeover?: () => void;
  onResolveAngelCard?: (useCard: boolean) => void;
  onBonusCoinGuess?: (guess: 'HEADS' | 'TAILS') => void;
  onBonusStopAndCollect?: () => void;
  onConfirmFortuneCard?: () => void;
  onBoardTilePicked?: (tileIndex: number, extraMode?: 'SELL' | 'SWAP') => void;
  onTakeBankLoan?: () => void;
  onSellCitiesForDebt?: (tileIndices: number[]) => void;
  onPayResolvedDebt?: () => void;
  onDeclareBankruptcy?: () => void;
  onToggleSpeed?: (speedMultiplier: 1 | 2 | 3) => void;
  onPlayerCardHover?: (playerId: PlayerId | null) => void;
  onKickPlayerSlot?: (playerId: PlayerId) => void;
  onAddAiSlot?: (slotIndex: number) => void;
  onAddHumanSlot?: (slotIndex: number) => void;
  onRandomizePlayerLoadout?: (playerId: PlayerId) => void;
  onRematch?: () => void;
  onReturnToLobby?: () => void;
}

/**
 * Computes the 4 distinct Main skills and additively stacked Sub skills ((÷3)×1.6 rates)
 * for any Character + 3 Treasures loadout.
 */
export function computeCombinedPlayerSkills(
  characterId: string,
  treasureIds: readonly string[],
  skillUsesRemaining?: Record<string, number>
): ActiveSkillSummary {
  const charDef = getCharacterDef(characterId);
  const mainSkills: ActiveSkillSummary['mainSkills'] = [];

  const charMainDef = getSkillDef(charDef.mainSkill.skillId);
  mainSkills.push({
    skill: charMainDef,
    procPct: charDef.mainSkill.procPct,
    sourceLabel: `${charDef.name} (Main)`,
    usesLeft:
      charMainDef.maxUsesPerMatch !== null
        ? (skillUsesRemaining?.[charMainDef.id] ?? charMainDef.maxUsesPerMatch)
        : null,
  });

  for (const tid of treasureIds) {
    const tr = getTreasureDef(tid);
    const mDef = getSkillDef(tr.mainSkill.skillId);
    if (!mainSkills.some((m) => m.skill.id === mDef.id)) {
      mainSkills.push({
        skill: mDef,
        procPct: tr.mainSkill.procPct,
        sourceLabel: `${tr.iconEmoji} ${tr.name}`,
        usesLeft:
          mDef.maxUsesPerMatch !== null
            ? (skillUsesRemaining?.[mDef.id] ?? mDef.maxUsesPerMatch)
            : null,
      });
    }
  }

  // Sub skills stack additively!
  const subMap = new Map<
    SubSkillId,
    { skill: SkillDefinition; total: number; parts: string[] }
  >();

  for (const sub of charDef.subSkills) {
    const sDef = getSkillDef(sub.skillId);
    const entry = subMap.get(sub.skillId) ?? {
      skill: sDef,
      total: 0,
      parts: [],
    };
    entry.total += sub.procPct;
    entry.parts.push(`${sub.procPct}%`);
    subMap.set(sub.skillId, entry);
  }

  for (const tid of treasureIds) {
    const tr = getTreasureDef(tid);
    const subId = tr.subSkill.skillId;
    const sDef = getSkillDef(subId);
    const entry = subMap.get(subId) ?? {
      skill: sDef,
      total: 0,
      parts: [],
    };
    entry.total += tr.subSkill.procPct;
    entry.parts.push(`${tr.subSkill.procPct}%`);
    subMap.set(subId, entry);
  }

  const subSkills: ActiveSkillSummary['subSkills'] = Array.from(
    subMap.values()
  ).map((item) => ({
    skill: item.skill,
    totalProcPct: Math.min(100, item.total),
    breakdown:
      item.parts.length > 1
        ? `${item.parts.join(' + ')} = ${Math.min(100, item.total)}%`
        : `${item.total}%`,
    usesLeft:
      item.skill.maxUsesPerMatch !== null
        ? (skillUsesRemaining?.[item.skill.id] ?? item.skill.maxUsesPerMatch)
        : null,
  }));

  return { mainSkills, subSkills };
}

export class UIManager {
  private rootEl: HTMLElement;
  private canvasHostEl!: HTMLElement;
  private stageEl!: HTMLElement;
  private callbacks: UICallbacks;

  private state: UIGameStateSnapshot;
  private selectedLoadoutPlayerId: PlayerId = 'P1';
  private selectedTreasureSlotIndex: 0 | 1 | 2 = 0;
  private youPlayerId: PlayerId | null = null;
  private loadoutInvTab: 'CHAR' | 'TR' = 'CHAR';
  private inspectedPlayerId: PlayerId = 'P1';
  private rulesTab: 'SKILLS' | 'CHANCE' | 'DICE' | 'MONOPOLY' = 'SKILLS';
  private speedMultiplier: 1 | 2 | 3 = 1;
  private mobileLobbyTab: 'PLAYERS' | 'CHAR' | 'TREASURES' = 'PLAYERS';
  private forceMobileLobbyOverride: boolean | null = null;
  private lastDetectedMobileLobby = false;

  // Rainbow Arc Gauge Charging State (2.00 .. 12.00)
  private gaugeVal = 7.0;
  private gaugeDir: 1 | -1 = 1;
  private gaugeRafId: number | null = null;
  private isChargingGauge = false;
  private lastGaugeFrameTime = 0;
  private lastTickSoundTime = 0;

  // Interactive Modal Local State
  private selectedBuildLevel: BuildingLevel = BuildingLevel.BUILDING;
  private lastCityModalKey: string | null = null;
  private selectedDebtSellTiles: Set<number> = new Set();
  private boardPickDisruptMode: 'SELL' | 'SWAP' = 'SELL';

  constructor(
    rootEl: HTMLElement,
    initialState: UIGameStateSnapshot,
    callbacks: UICallbacks = {}
  ) {
    this.rootEl = rootEl;
    this.state = initialState;
    this.callbacks = callbacks;

    this.mountDOM();
    this.setupResponsiveScale();
    this.setupKeyboardShortcuts();
    this.renderAll();
  }

  public getCanvasContainer(): HTMLElement {
    return this.canvasHostEl;
  }

  public setCallbacks(callbacks: Partial<UICallbacks>): void {
    this.callbacks = { ...this.callbacks, ...callbacks };
  }

  public sync(nextState: UIGameStateSnapshot): void {
    const prevScreen = this.state.screen;
    this.state = nextState;
    if (prevScreen !== nextState.screen) {
      this.updateScreenVisibility();
    }
    this.renderAll();

    if (this.state.screen === 'IN_GAME') {
      const activeP = this.getActivePlayer();
      if (this.state.phase === 'IDLE_ROLL' && this.canHumanRollNow() && !this.isChargingGauge && activeP) {
        this.callbacks.onGaugeStepChange?.(activeP.tileIndex, Math.round(this.gaugeVal));
      } else if (this.state.phase !== 'IDLE_ROLL' && this.state.phase !== 'GAUGE_CHARGING' && !this.isChargingGauge) {
        this.callbacks.onGaugeStepChange?.(null, null);
      }
    }
  }

  public setYouPlayerId(pid: PlayerId | null): void {
    this.youPlayerId = pid;
    if (pid) {
      this.selectedLoadoutPlayerId = pid;
    }
  }

  /**
   * Checks whether the current screen/device is authorized to control the given player slot.
   * Supports Pass 'n Play: local human slots are controlled on this device.
   */
  public canControlSlotLocally(pid: PlayerId): boolean {
    const p = this.state.players.find((x) => x.id === pid);
    if (!p || p.controlType !== 'HUMAN') return false;

    // Offline mode: all human slots are local Pass 'n Play
    if (!this.youPlayerId) return true;

    // If directly assigned to this client
    if (this.youPlayerId === pid) return true;

    // If another remote player is connected to this slot, disallow local control
    if (p.connected && p.id !== this.youPlayerId) return false;

    // In local Pass 'n Play on host, any unassigned or local human slot is controllable
    return true;
  }

  public showScreen(screen: ScreenState, playerForLoadout?: PlayerId): void {
    if (playerForLoadout) {
      this.selectedLoadoutPlayerId = playerForLoadout;
    }
    // Main Menu and Loadout are merged directly into Lobby
    if (screen === 'MAIN_MENU' || screen === 'LOADOUT') {
      screen = 'LOBBY';
    }
    this.state.screen = screen;
    this.updateScreenVisibility();
    this.renderAll();
    this.callbacks.onScreenChange?.(screen);
  }

  public updateHoveredTile(tileIndex: number | null): void {
    const card = this.stageEl.querySelector(
      '#tileHoverCard'
    ) as HTMLElement | null;
    if (!card) return;

    if (
      tileIndex === null ||
      tileIndex < 0 ||
      tileIndex >= WORLD_MAP_TILES.length ||
      this.state.screen !== 'IN_GAME'
    ) {
      card.classList.remove('visible');
      return;
    }

    const def = WORLD_MAP_TILES[tileIndex];
    const tileState = this.state.tiles[tileIndex];
    if (!def || !tileState) {
      card.classList.remove('visible');
      return;
    }

    card.classList.add('visible');

    let bodyHtml = '';

    if (def.type === 'START') {
      bodyHtml = `
        <div style="font-size:11px; color:#cbd5e1; line-height:1.4;">
          🏁 <strong style="color:#4ade80;">จุดเริ่มต้น (START)</strong><br/>
          รับเงินเดือนก้อนโตเมื่อเดินผ่าน หรือลงจอดที่ช่องนี้ (สามารถเลือกอัปเกรดเมืองใดก็ได้ 1 ระดับ)
        </div>
      `;
    } else if (def.type === 'DESERT_ISLAND') {
      bodyHtml = `
        <div style="font-size:11px; color:#cbd5e1; line-height:1.4;">
          🏝️ <strong style="color:#f87171;">เกาะร้าง (DESERT ISLAND)</strong><br/>
          ผู้เล่นที่ตกช่องนี้จะติดเกาะ 3 เทิร์น เว้นแต่จะทอยได้ดับเบิ้ล หรือจ่ายค่าหลบหนี
        </div>
      `;
    } else if (def.type === 'OLYMPIC') {
      bodyHtml = `
        <div style="font-size:11px; color:#cbd5e1; line-height:1.4;">
          🏅 <strong style="color:#fde047;">จัดโอลิมปิก (OLYMPIC EXPO)</strong><br/>
          เลือกเมืองของตนเองเพื่อเป็นเจ้าภาพโอลิมปิก เพิ่มค่าผ่านทางอย่างถาวร x2, x4, x8
        </div>
      `;
    } else if (def.type === 'WORLD_TRAVEL') {
      bodyHtml = `
        <div style="font-size:11px; color:#cbd5e1; line-height:1.4;">
          ✈️ <strong style="color:#38bdf8;">สนามบินรอบโลก (SKY TERMINAL)</strong><br/>
          จ่ายค่าตั๋วเพื่อจองเที่ยวบิน ในเทิร์นถัดไปสามารถบินไปยังช่องใดก็ได้บนกระดานทันที
        </div>
      `;
    } else if (def.type === 'TAX_AUDIT') {
      bodyHtml = `
        <div style="font-size:11px; color:#cbd5e1; line-height:1.4;">
          ⚖️ <strong style="color:#f87171;">สรรพากร (TAX AUDIT)</strong><br/>
          จ่ายภาษี 10% ของเงินสดและมูลค่าทรัพย์สินทั้งหมดในครอบครอง
        </div>
      `;
    } else if (def.type === 'CHANCE') {
      bodyHtml = `
        <div style="font-size:11px; color:#f59e0b;">
          ❓ <strong style="color:#f59e0b;">การ์ดดวง (FORTUNE CARD)</strong><br/>
          สุ่มรับการ์ดสิทธิพิเศษ เช่น การ์ดนางฟ้า, บังคับขายเมือง, สลับเมือง, วาร์ป หรือจัดงานเทศกาล
        </div>
      `;
    } else if (def.type === 'BONUS_GAME') {
      bodyHtml = `
        <div style="font-size:11px; color:#cbd5e1; line-height:1.4;">
          🎰 <strong style="color:#a855f7;">มินิเกมโบนัส (BONUS GAME)</strong><br/>
          ทายหัว/ก้อย 3 รอบ ชนะติดต่อกันเพื่อคูณเงินรางวัลสูงสุด x8 เท่า
        </div>
      `;
    } else {
      // CITY or TOURISM
      const owner = tileState.ownerId
        ? this.state.players.find((p) => p.id === tileState.ownerId)
        : null;

      let baseToll = 0;
      if (def.type === 'TOURISM') {
        const ownedIndices = owner
          ? WORLD_MAP_TILES.filter(
              (t) =>
                t.type === 'TOURISM' &&
                this.state.tiles[t.index]?.ownerId === owner.id
            ).map((t) => t.index)
          : [];
        const scale = getTourismMultiplierForTile(def.index, ownedIndices);
        baseToll = def.baseToll * scale;
      } else {
        const mult =
          MATCH_CONFIG.buildingTollMultipliers[tileState.buildingLevel] ?? 1;
        baseToll = def.baseToll * mult;
      }

      const isColorMonopoly =
        def.group !== null &&
        owner &&
        WORLD_MAP_TILES.filter((t) => t.group === def.group).every(
          (t) => this.state.tiles[t.index]?.ownerId === owner.id
        );
      const festivalMult = tileState.isFestival
        ? MATCH_CONFIG.festivalTollMultiplier
        : 1;
      const monoMult = isColorMonopoly
        ? MATCH_CONFIG.colorMonopolyTollMultiplier
        : 1;
      const olympicMult = Math.max(1, tileState.olympicMultiplier || 1);
      const stepMult = Math.max(1, tileState.stepMultiplier || 1);
      const isLate =
        this.state.turnNumber >= MATCH_CONFIG.lateGameTurnThreshold;
      const lateMult = isLate ? MATCH_CONFIG.lateGameTollMultiplier : 1;

      const totalToll = tileState.isBlackout
        ? 0
        : Math.round(
            baseToll *
              festivalMult *
              monoMult *
              olympicMult *
              stepMult *
              lateMult
          );

      const levelLabels: Record<BuildingLevel, string> = {
        [BuildingLevel.NONE]: 'ยังไม่มีสิ่งก่อสร้าง',
        [BuildingLevel.LAND]: '🌱 ที่ดิน (Land)',
        [BuildingLevel.VILLA]: '🏡 วิลล่า (Villa)',
        [BuildingLevel.BUILDING]: '🏢 ตึก (Building)',
        [BuildingLevel.HOTEL]: '🏨 โรงแรม (Hotel)',
        [BuildingLevel.LANDMARK]: '⭐ แลนด์มาร์ก (Landmark)',
      };

      const tierBadge =
        def.type === 'TOURISM'
          ? (def.tourismGroup === 'BLUE' ? '🏝️ เกาะสีฟ้า (2x/4x)' : '🌺 เกาะสีแดง (3x)')
          : levelLabels[tileState.buildingLevel] ?? 'อาคาร';

      const multTags: string[] = [];
      if (tileState.isFestival) multTags.push('🎉 เทศกาล x2');
      if (isColorMonopoly) multTags.push('🎨 สีผูกขาด x2');
      if (olympicMult > 1) multTags.push(`🏅 โอลิมปิก x${olympicMult}`);
      if (stepMult > 1) multTags.push(`👣 สเต็ป x${stepMult}`);
      if (isLate) multTags.push('🔥 ท้ายเกม x1.5');
      if (tileState.isBlackout) multTags.push('⚡ ไฟดับ (0)');

      const multRow =
        multTags.length > 0
          ? `<div style="display:flex; flex-wrap:wrap; gap:3px; margin-top:2px;">
              ${multTags
                .map(
                  (tag) =>
                    `<span style="font-size:9px; background:rgba(234,88,12,0.3); border:1px solid #f97316; border-radius:3px; padding:0 4px; color:#fdba74;">${tag}</span>`
                )
                .join('')}
            </div>`
          : '';

      let actionCostHtml = '';
      if (!owner) {
        actionCostHtml = `
          <div style="display:flex; justify-content:space-between; font-size:10px; color:#94a3b8; border-top:1px dashed rgba(255,255,255,0.15); padding-top:4px;">
            <span>💵 ราคาซื้อ:</span>
            <strong style="color:#4ade80;">${formatMarbleCompact(def.baseCost)}</strong>
          </div>
        `;
      } else if (tileState.buildingLevel === BuildingLevel.LANDMARK) {
        actionCostHtml = `
          <div style="font-size:10px; color:#fde047; font-weight:800; border-top:1px dashed rgba(255,255,255,0.15); padding-top:4px; text-align:center;">
            🔒 แลนด์มาร์ก (ไม่สามารถเทคโอเวอร์ได้)
          </div>
        `;
      } else {
        const invested =
          def.baseCost *
          (MATCH_CONFIG.buildingCostMultipliers[tileState.buildingLevel] ?? 1);
        const takeoverCost = Math.round(
          invested * MATCH_CONFIG.takeoverCostMultiplier
        );
        actionCostHtml = `
          <div style="display:flex; justify-content:space-between; font-size:10px; color:#cbd5e1; border-top:1px dashed rgba(255,255,255,0.15); padding-top:4px;">
            <span>💰 ค่าเทคโอเวอร์ (x2.0):</span>
            <strong style="color:#f87171;">${formatMarbleCompact(takeoverCost)}</strong>
          </div>
        `;
      }

      bodyHtml = `
        <div style="display:flex; justify-content:space-between; align-items:center;">
          <span style="font-size:10px; color:#94a3b8;">เจ้าของ:</span>
          ${
            owner
              ? `<span style="font-size:11px; font-weight:800; color:${owner.colorHex}; display:flex; align-items:center; gap:4px;">
                  <span>${getCharacterDef(owner.characterId).avatarEmoji}</span>
                  <span>${owner.name}</span>
                </span>`
              : `<span style="font-size:11px; font-weight:700; color:#4ade80;">ยังไม่มีเจ้าของ</span>`
          }
        </div>
        <div style="display:flex; justify-content:space-between; align-items:center; font-size:10.5px;">
          <span style="color:#94a3b8;">สิ่งก่อสร้าง:</span>
          <span style="font-weight:800; color:#fef08a;">${tierBadge}</span>
        </div>
        <div style="display:flex; justify-content:space-between; align-items:center; font-size:10.5px;">
          <span style="color:#94a3b8;">ค่าผ่านทาง:</span>
          <strong style="font-size:12px; color:#fde047; text-shadow:0 0 6px rgba(253,224,71,0.4);">
            ${owner ? formatMarbleFull(totalToll) : '0'}
          </strong>
        </div>
        ${multRow}
        ${actionCostHtml}
      `;
    }

    card.innerHTML = `
      <div style="display:flex; align-items:center; justify-content:space-between; border-bottom:1px solid rgba(255,255,255,0.12); padding-bottom:4px;">
        <div style="display:flex; align-items:center; gap:6px;">
          <span style="display:inline-block; width:10px; height:10px; border-radius:3px; background:${def.colorHex}; box-shadow:0 0 6px ${def.colorHex};"></span>
          <span style="font-weight:900; font-size:13px; color:#ffffff;">${def.nameTh}</span>
          <span style="font-size:10px; color:#94a3b8;">${def.name}</span>
        </div>
        <span style="font-size:9.5px; font-weight:800; background:rgba(255,255,255,0.1); padding:1px 6px; border-radius:4px; color:#e2e8f0;">#${tileIndex} ${def.type}</span>
      </div>
      ${bodyHtml}
    `;
  }

  public showSkillCutIn(message: string, isProc = true): void {
    const banner = this.stageEl.querySelector(
      '#liveBanner'
    ) as HTMLElement | null;
    if (!banner) return;
    banner.innerHTML = message;
    if (isProc) {
      soundManager.playSkillCutin();
      banner.classList.remove('proc-flash');
      void banner.offsetWidth;
      banner.classList.add('proc-flash');
    }
  }

  public showCashDelta(playerId: PlayerId, deltaAmount: number): void {
    if (Math.abs(deltaAmount) < 1) return;
    const card = this.stageEl.querySelector(
      `#hudCard_${playerId}`
    ) as HTMLElement | null;
    if (!card) return;

    if (deltaAmount > 0) {
      soundManager.playCoinGain();
    } else {
      soundManager.playCoinLoss();
    }

    const pill = document.createElement('div');
    pill.className = `cash-delta-float ${deltaAmount > 0 ? 'gain' : 'loss'}`;
    pill.textContent = `${deltaAmount > 0 ? '+' : ''}${formatMarbleCompact(deltaAmount)}`;
    card.appendChild(pill);
    window.setTimeout(() => {
      pill.remove();
    }, 1850);
  }

  public updateDiceVisuals(
    d1: number,
    d2: number,
    gaugeValue?: number
  ): void {
    const isDouble = d1 === d2;
    if (isDouble) {
      soundManager.playDoubleFanfare();
    }
    this.state.lastDice = {
      d1,
      d2,
      sum: d1 + d2,
      isDouble,
      gaugeValue,
    };
    if (typeof gaugeValue === 'number') {
      this.gaugeVal = Math.max(2, Math.min(12, gaugeValue));
      this.updateNeedleVisual();
    }
    this.renderCenterDiceReadout();
  }

