        <div style="display:flex; flex-direction:column; align-items:center; justify-content:center; position:relative; gap:14px;">
          <div style="width:248px; height:248px; border-radius:50%; background:radial-gradient(circle at 35% 35%, #6ee7b7 0%, #3b82f6 55%, #1e3a8a 100%); border:5px solid #bae6fd; box-shadow:0 0 42px rgba(56,189,248,0.7), inset 0 4px 12px rgba(255,255,255,0.55); display:flex; flex-direction:column; align-items:center; justify-content:center; position:relative;">
