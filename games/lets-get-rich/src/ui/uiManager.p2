            <div style="position:absolute; top:-10px; right:-16px; background:linear-gradient(180deg,#ef4444,#b91c1c); border:2.5px solid #ffffff; border-radius:10px; padding:5px 12px; font-weight:900; font-size:14px; transform:rotate(12deg); box-shadow:0 6px 14px rgba(0,0,0,0.5);">
              🎲 DOUBLE 12!
            </div>
            <div style="position:absolute; bottom:-12px; background:#0f172a; border:2px solid #fde047; border-radius:99px; padding:4px 16px; font-size:12px; font-weight:900; color:#fde047; box-shadow:0 4px 10px rgba(0,0,0,0.5);">
              8 ตัวละคร • 10 สมบัติ • 20 สกิลฮิต
            </div>
          </div>
        </div>

        <!-- Right Mode Cards: 4P Free-For-All & 2v2 Team Match -->
        <div style="display:grid; grid-template-columns: 1fr 1fr; gap:18px; height:92%;">
          <!-- 2-4P FREE-FOR-ALL Card -->
          <div style="background:linear-gradient(180deg, #f97316 0%, #b45309 55%, #78350f 100%); border:3.5px solid #fde047; border-radius:20px; padding:18px; display:flex; flex-direction:column; justify-content:space-between; align-items:center; text-align:center; box-shadow:0 12px 28px rgba(0,0,0,0.55), inset 0 2px 2px rgba(255,255,255,0.45);">
            <div>
              <div style="font-size:42px; font-weight:900; color:#fef08a; text-shadow:0 3px 6px rgba(0,0,0,0.65); line-height:1;">2–4P</div>
