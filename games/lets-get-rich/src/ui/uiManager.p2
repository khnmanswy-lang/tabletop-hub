  // ==========================================================================
  // SCREEN 2: CHARACTER & TREASURE LOADOUT (Reference Image 2 — Clean Header + P1..P4 Switcher)
  // ==========================================================================
  private renderLoadoutScreen(): void {
    const container = this.stageEl.querySelector(
      '#screen_LOADOUT'
    ) as HTMLElement;
    if (!container) return;

    const targetPlayer =
      this.state.players.find((p) => p.id === this.selectedLoadoutPlayerId) ??
      this.state.players[0];
    if (!targetPlayer) return;

    const curChar: CharacterDef = getCharacterDef(targetPlayer.characterId);
    const curTrIds = [...targetPlayer.treasureIds] as [string, string, string];
    const combinedSkills = computeCombinedPlayerSkills(
      curChar.id,
      curTrIds,
      targetPlayer.skillUsesRemaining
    );

    const statsList = [
      {
        label: `🎲 Dice Control (DC ${STAT_SCALING_TABLE.dcProcPct[curChar.stats.dc]}%)`,
        lv: curChar.stats.dc,
        color: '#38bdf8',
      },
      {
        label: `🛠️ Construction Discount (-${STAT_SCALING_TABLE.constDiscountPct[curChar.stats.constDc]}%)`,
        lv: curChar.stats.constDc,
        color: '#fb923c',
      },
      {
        label: `🤝 Acquisition Discount (-${STAT_SCALING_TABLE.acqDiscountPct[curChar.stats.acqDc]}%)`,
        lv: curChar.stats.acqDc,
        color: '#facc15',
      },
      {
        label: `🛡️ Toll Discount (-${STAT_SCALING_TABLE.tollDiscountPct[curChar.stats.tollDc]}%)`,
        lv: curChar.stats.tollDc,
        color: '#f59e0b',
      },
      {
        label: `🍀 Salary/Luck (+${STAT_SCALING_TABLE.salLuckBonusPct[curChar.stats.salLuck]}%)`,
        lv: curChar.stats.salLuck,
        color: '#4ade80',
      },
    ];

    const statBarsHtml = statsList
      .map((s) => {
        let segs = '';
        for (let i = 1; i <= 5; i++) {
          segs += `<div style="flex:1; height:10px; border-radius:3px; background:${
            i <= s.lv ? s.color : '#0f172a'
          }; border:1px solid #334155; box-shadow:${
            i <= s.lv ? `0 0 6px ${s.color}88` : 'none'
          };"></div>`;
        }
        return `
          <div>
            <div style="display:flex; justify-content:space-between; font-size:12px; font-weight:800; margin-bottom:3px;">
              <span>${s.label}</span>
              <span style="color:#93c5fd;">+${s.lv} / +5</span>
            </div>
            <div style="display:flex; gap:4px;">${segs}</div>
          </div>
        `;
      })
      .join('');

    const equippedSlotsHtml = curTrIds
      .map((tid, idx) => {
        const tr = getTreasureDef(tid);
        const mSkill = getSkillDef(tr.mainSkill.skillId);
        const sSkill = getSkillDef(tr.subSkill.skillId);
        return `
          <div style="background:linear-gradient(180deg,#1e3a8a,#0f172a); border:2px solid #fde047; border-radius:10px; padding:6px 5px; text-align:center; display:flex; flex-direction:column; justify-content:space-between;">
            <div style="font-size:10px; color:#fde047; font-weight:900;">SLOT ${idx + 1}</div>
            <div style="font-size:26px; line-height:1.1;">${tr.iconEmoji}</div>
            <div style="font-size:11px; font-weight:900; color:#ffffff; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">${tr.name}</div>
            <div style="font-size:10px; color:#93c5fd;">${mSkill.code} (${tr.mainSkill.procPct}%) + ${sSkill.code} (+${tr.subSkill.procPct}%)</div>
          </div>
        `;
      })
      .join('');

    const charMainDef = getSkillDef(curChar.mainSkill.skillId);
    const charSub1Def = getSkillDef(curChar.subSkills[0].skillId);
    const charSub2Def = getSkillDef(curChar.subSkills[1].skillId);

    const stackedSubsHtml = combinedSkills.subSkills
      .map(
        (sub) => `
          <div style="background:#0f172a; border:1px solid #334155; border-radius:6px; padding:3px 7px; display:flex; justify-content:space-between; align-items:center; font-size:11px;">
            <span><strong style="color:#7dd3fc;">${sub.skill.code}</strong> ${sub.skill.name}</span>
            <strong style="color:#4ade80;">${sub.breakdown}</strong>
          </div>
        `
      )
      .join('');

    const inventoryGridHtml =
      this.loadoutInvTab === 'CHAR'
        ? CHARACTER_ROSTER.map((c) => {
            const isSelected = c.id === curChar.id;
            const mDef = getSkillDef(c.mainSkill.skillId);
            return `
              <div class="inv-char-card" data-char-id="${c.id}" style="background:linear-gradient(180deg,#3b82f6,#1d4ed8); border:2.5px solid ${
                isSelected ? '#fde047' : '#60a5fa'
              }; border-radius:10px; padding:7px 5px; text-align:center; cursor:pointer; position:relative; box-shadow:${
                isSelected ? '0 0 12px rgba(250,204,21,0.65)' : 'none'
              };">
                <span style="position:absolute; top:3px; left:5px; font-size:11px; font-weight:900; color:#fde047;">${c.rank}</span>
                <div style="font-size:30px; line-height:1.15;">${c.avatarEmoji}</div>
                <div style="font-size:12px; font-weight:900; color:#ffffff;">${c.name}</div>
                <div style="font-size:10px; color:#fef08a; font-weight:800;">${mDef.code}: ${c.mainSkill.procPct}%</div>
              </div>
            `;
          }).join('')
        : TREASURE_POOL.map((t) => {
            const isConflict = isMainSkillConflict(t.mainSkill.skillId, curChar.mainSkill.skillId);
            const isEquipped = curTrIds.includes(t.id);
            const mDef = getSkillDef(t.mainSkill.skillId);
            const sDef = getSkillDef(t.subSkill.skillId);
            return `
              <div class="inv-tr-card" data-tr-id="${t.id}" style="background:linear-gradient(180deg,#1e293b,#0f172a); border:2.5px solid ${
                isConflict
                  ? '#ef4444'
                  : isEquipped
                    ? '#fde047'
                    : '#475569'
              }; opacity:${
                isConflict ? 0.45 : 1
              }; border-radius:10px; padding:6px 5px; text-align:center; cursor:${
                isConflict ? 'not-allowed' : 'pointer'
              }; position:relative;">
                ${
                  isEquipped
                    ? `<span style="position:absolute; top:2px; right:4px; font-size:10px; font-weight:900; color:#4ade80;">✔</span>`
                    : ''
                }
                <div style="font-size:26px; line-height:1.15;">${t.iconEmoji}</div>
                <div style="font-size:11px; font-weight:900; color:#fde047; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">${t.name}</div>
                <div style="font-size:10px; color:${
                  isConflict ? '#fca5a5' : '#93c5fd'
                }; font-weight:800;">
                  ${
                    isConflict
                      ? '⛔ ซ้ำ Main ตลค'
                      : `${mDef.code}(${t.mainSkill.procPct}%) + ${sDef.code}(+${t.subSkill.procPct}%)`
                  }
                </div>
              </div>
            `;
          }).join('');

    const playerSwitcherHtml = this.state.players
      .map((p) => {
        const pChar = getCharacterDef(p.characterId);
        const active = p.id === this.selectedLoadoutPlayerId;
        return `
          <button class="tab-pill loadout-p-switch ${active ? 'active' : ''}" data-pid="${p.id}" style="padding:5px 12px; font-size:12px; display:flex; align-items:center; gap:5px;">
            <span>${pChar.avatarEmoji}</span>
            <span>${p.id} (${pChar.name})</span>
          </button>
        `;
      })
      .join('');

    container.innerHTML = `
      <!-- Top Clean Bar: Back/Home + Title on Left | Player Switcher P1..