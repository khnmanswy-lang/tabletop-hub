          <button class="tab-pill" id="menuNavFullscreen" style="padding:8px 14px; font-size:13px;">
            ⛶ Fullscreen
          </button>
        </div>
      </div>

      <!-- Center Content: Globe Hero on Left + 4P & 2v2 Tall Banners on Right -->
      <div style="display:grid; grid-template-columns: 42% 58%; height:calc(100% - 136px); align-items:center; margin-top:8px;">
